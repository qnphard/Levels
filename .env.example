# Copy to `.env` (do not commit `.env`). Restart Expo after changes.
#
# GitHub Actions (Android APK): create repository secrets with the SAME names as these
# variables (EXPO_PUBLIC_FIREBASE_*, etc.) so the release bundle embeds config. Local .env
# is not used on CI.

# Firebase — Project settings → General → Your apps (Web)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Sign-In — OAuth 2.0 Client IDs (Google Cloud Console → APIs & Services → Credentials)
# Required for “Continue with Google” on GitHub-built APKs: add EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID as a repo secret too.
# Use the Web client's Client ID (ends with .apps.googleusercontent.com).
# If you see "Error 401: invalid_client" / "OAuth client was not found":
#   1) Confirm the project dropdown is the SAME Google Cloud project linked to Firebase (Project settings).
#   2) Open the Web OAuth client → Authorized redirect URIs → add BOTH:
#        https://auth.expo.io/@qnphard/meditation-app
#        com.anonymous.levels:/oauthredirect
#   3) Authorized JavaScript origins (for web): http://localhost:8081  and  https://auth.expo.io
#   4) Optional: create an Android OAuth client (type Android) with package com.anonymous.levels
#      and your debug SHA-1, then set EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID to that client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
